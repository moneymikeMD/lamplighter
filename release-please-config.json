{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "lamplighter",
      "include-component-in-tag": false,
      "release-as": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "crates/lampl/Cargo.toml", "jsonpath": "$.dependencies.lampl-embed.version" },
        { "type": "toml", "path": "crates/lampl/Cargo.toml", "jsonpath": "$.dependencies.lampl-core.version" },
        { "type": "toml", "path": "crates/lampl/Cargo.toml", "jsonpath": "$.dependencies.lampl-store-pg.version" },
        { "type": "toml", "path": "crates/lampl-store-pg/Cargo.toml", "jsonpath": "$.dependencies.lampl-core.version" },
        { "type": "toml", "path": "crates/lamplighter/Cargo.toml", "jsonpath": "$.dependencies.lampl.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lampl')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lampl-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lampl-embed')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lampl-store-pg')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lampl-store-sqlite')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lamplighter')].version" }
      ]
    }
  }
}
